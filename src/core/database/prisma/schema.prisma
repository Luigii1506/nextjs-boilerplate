// 🏗️ NEXTJS ENTERPRISE BOILERPLATE - SCHEMA MODULAR
// ================================================
// Archivo principal: Solo configuración (generator + datasource)
// Los modelos están organizados en archivos separados en ./models/

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 📁 MODELOS ORGANIZADOS EN ARCHIVOS SEPARADOS:
// ============================================
//
// 🔐 ./models/auth.prisma          - User, Session, Account, Verification
// 🚛 ./models/supplier.prisma      - Supplier (SHARED: inventory, pos, services)
// 🎛️ ./models/feature-flags.prisma - FeatureFlag, FeatureFlagHistory, ModuleConfig
// 📁 ./models/file-upload.prisma   - Upload, FileCategory
// 📊 ./models/audit.prisma         - AuditEvent, AuditChange
// 📦 ./models/inventory.prisma     - Product, Category, StockMovement
// 🛒 ./models/storefront.prisma    - Cart, Order, Review, Promotion, Coupon
// 🏪 ./models/pos.prisma           - POSSession, POSTransaction, POSTransactionItem
//
// Prisma automáticamente combina todos los archivos .prisma en este directorio
